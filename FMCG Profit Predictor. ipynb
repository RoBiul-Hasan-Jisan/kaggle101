    "def predict_profit_and_profitability(features_dict):\n",
    "   \n",
    "    # Create DataFrame from input\n",
    "    input_df = pd.DataFrame([features_dict])\n",
    "    \n",
    "    # Encode categorical variables\n",
    "    for col in categorical_cols:\n",
    "        if col in input_df.columns and col in label_encoders:\n",
    "            input_df[f'{col}_encoded'] = label_encoders[col].transform([str(input_df[col].iloc[0])])\n",
    "    \n",
    "    # Select features\n",
    "    X_input = input_df[[f for f in regression_features if f in input_df.columns]]\n",
    "    \n",
    "    # Handle missing features\n",
    "    for f in regression_features:\n",
    "        if f not in X_input.columns:\n",
    "            X_input[f] = 0\n",
    "    \n",
    "    X_input = X_input[regression_features]\n",
    "    X_input = X_input.fillna(0)\n",
    "    \n",
    "    # Scale\n",
    "    X_input_scaled = scaler_reg.transform(X_input)\n",
    "    \n",
    "    # Predict\n",
    "    profit_pred = best_reg_tuned.predict(X_input_scaled)[0]\n",
    "    profitability_pred = best_clf_tuned.predict_proba(X_input_scaled)[0, 1]\n",
    "    \n",
    "    return {\n",
    "        'predicted_profit_usd': profit_pred,\n",
    "        'profitability_probability': profitability_pred,\n",
    "        'is_profitable': profitability_pred > 0.5,\n",
    "        'risk_level': 'Low' if profitability_pred > 0.7 else 'Medium' if profitability_pred > 0.3 else 'High'\n",
    "    }\n",
    "\n",
    "# Example usage\n",
    "print(\"\\n Example Prediction:\")\n",
    "example_order = {\n",
    "    'Units_Sold': 100,\n",
    "    'Unit_Price_USD': 5.99,\n",
    "    'Discount_Pct': 10,\n",
    "    'Marketing_Spend_USD': 50,\n",
    "    'COGS_USD': 300,\n",
    "    'Logistics_Cost_USD': 25,\n",
    "    'Customer_Type': 'B2C',\n",
    "    'Sales_Channel': 'Online'\n",
    "}\n",
    "\n",
    "result = predict_profit_and_profitability(example_order)\n",
    "print(f\"Predicted Profit: ${result['predicted_profit_usd']:.2f}\")\n",
    "print(f\"Profitability Probability: {result['profitability_probability']:.1%}\")\n",
    "print(f\"Risk Level: {result['risk_level']}\")\n"
