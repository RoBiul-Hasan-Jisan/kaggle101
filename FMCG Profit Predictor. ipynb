    "\n",
    "# Add encoded categoricals\n",
    "encoded_cats = [col for col in df_model.columns if col.endswith('_encoded')]\n",
    "regression_features.extend(encoded_cats)\n",
    "\n",
    "# Ensure all features exist\n",
    "regression_features = [f for f in regression_features if f in df_model.columns]\n",
    "\n",
    "# Target variable\n",
    "target_reg = 'Profit_USD'\n",
    "\n",
    "# Prepare data\n",
    "X_reg = df_model[regression_features].copy()\n",
