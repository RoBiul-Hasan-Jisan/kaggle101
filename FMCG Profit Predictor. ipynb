    "#  Feature Importance for Profit Prediction\n",
    "print(\"\\n Feature Importance Analysis:\")\n",
    "\n",
    "# Prepare data\n",
    "features_for_importance = ['Units_Sold', 'Unit_Price_USD', 'Discount_Pct', \n",
    "                           'Marketing_Spend_USD', 'COGS_USD', 'Logistics_Cost_USD',\n",
