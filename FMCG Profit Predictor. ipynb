    "\n",
    "# Create copy for feature engineering\n",
    "df_fe = df.copy()\n",
    "\n",
    "# Temporal features \n",
    "df_fe['Order_Date'] = pd.to_datetime(df_fe['Order_Date'])\n",
    "df_fe['Day_of_Week'] = df_fe['Order_Date'].dt.dayofweek\n",
    "df_fe['Day_of_Week_Name'] = df_fe['Order_Date'].dt.day_name()\n",
    "df_fe['Week_of_Year'] = df_fe['Order_Date'].dt.isocalendar().week\n",
    "df_fe['Day_of_Month'] = df_fe['Order_Date'].dt.day\n",
    "df_fe['Is_Weekend'] = (df_fe['Day_of_Week'] >= 5).astype(int)\n",
    "df_fe['Is_Month_Start'] = (df_fe['Day_of_Month'] <= 7).astype(int)\n",
    "df_fe['Is_Month_End'] = (df_fe['Day_of_Month'] >= 25).astype(int)\n",
    "\n",
    "# Lag features (requires sorting by date)\n",
    "df_fe = df_fe.sort_values('Order_Date')\n",
    "df_fe['Revenue_Lag_7'] = df_fe.groupby('Product_Category')['Net_Revenue_USD'].shift(7)\n",
    "df_fe['Revenue_Lag_30'] = df_fe.groupby('Product_Category')['Net_Revenue_USD'].shift(30)\n",
    "df_fe['Profit_Lag_7'] = df_fe.groupby('Product_Category')['Profit_USD'].shift(7)\n",
    "df_fe['Profit_Lag_30'] = df_fe.groupby('Product_Category')['Profit_USD'].shift(30)\n",
    "\n",
    "# Rolling statistics\n",
    "df_fe['Revenue_MA_7'] = df_fe.groupby('Product_Category')['Net_Revenue_USD'].transform(\n",
    "    lambda x: x.rolling(window=7, min_periods=1).mean()\n",
    ")\n",
    "df_fe['Profit_MA_7'] = df_fe.groupby('Product_Category')['Profit_USD'].transform(\n",
    "    lambda x: x.rolling(window=7, min_periods=1).mean()\n",
    ")\n",
    "\n",
    "# Interaction features\n",
    "df_fe['Discount_Unit_Impact'] = df_fe['Discount_Pct'] * df_fe['Unit_Price_USD']\n",
    "df_fe['Marketing_per_Unit'] = df_fe['Marketing_Spend_USD'] / (df_fe['Units_Sold'] + 1)\n",
    "df_fe['Logistics_per_Unit'] = df_fe['Logistics_Cost_USD'] / (df_fe['Units_Sold'] + 1)\n",
    "df_fe['COGS_per_Unit'] = df_fe['COGS_USD'] / (df_fe['Units_Sold'] + 1)\n",
    "df_fe['Total_Cost_per_Unit'] = (df_fe['COGS_USD'] + df_fe['Logistics_Cost_USD'] + df_fe['Marketing_Spend_USD']) / (df_fe['Units_Sold'] + 1)\n",
    "\n",
    "# Ratio features\n",
    "df_fe['Marketing_to_Revenue_Ratio'] = df_fe['Marketing_Spend_USD'] / (df_fe['Net_Revenue_USD'] + 1)\n",
    "df_fe['Logistics_to_Revenue_Ratio'] = df_fe['Logistics_Cost_USD'] / (df_fe['Net_Revenue_USD'] + 1)\n",
    "df_fe['COGS_to_Revenue_Ratio'] = df_fe['COGS_USD'] / (df_fe['Net_Revenue_USD'] + 1)\n",
    "df_fe['Discount_Efficiency'] = df_fe['Profit_USD'] / (df_fe['Discount_Pct'] + 1)\n",
    "\n",
    "# Aggregated features by group\n",
    "df_fe['Avg_Discount_by_Brand'] = df_fe.groupby('Brand')['Discount_Pct'].transform('mean')\n",
    "df_fe['Avg_Profit_Margin_by_Channel'] = df_fe.groupby('Sales_Channel')['Profit_Margin_Pct'].transform('mean')\n",
    "df_fe['Units_Sold_by_Region'] = df_fe.groupby('Region')['Units_Sold'].transform('mean')\n",
    "df_fe['Revenue_by_Product'] = df_fe.groupby('Product_Name')['Net_Revenue_USD'].transform('mean')\n",
    "\n",
    "# Binning features\n",
    "df_fe['Discount_Bin'] = pd.cut(df_fe['Discount_Pct'], bins=[0, 5, 10, 15, 20, 25, 100], \n",
    "                                labels=['0-5%', '5-10%', '10-15%', '15-20%', '20-25%', '25%+'])\n",
    "df_fe['Units_Bin'] = pd.qcut(df_fe['Units_Sold'], q=4, labels=['Small', 'Medium', 'Large', 'X-Large'])\n",
    "df_fe['Revenue_Bin'] = pd.qcut(df_fe['Net_Revenue_USD'], q=4, labels=['Low', 'Medium', 'High', 'Very High'])\n",
    "\n",
    "# Profitability flags\n",
    "df_fe['Is_High_Margin'] = (df_fe['Profit_Margin_Pct'] > df_fe['Profit_Margin_Pct'].median()).astype(int)\n",
    "df_fe['Is_Loss_Making'] = (df_fe['Profit_USD'] < 0).astype(int)\n",
    "df_fe['Is_High_Discount'] = (df_fe['Discount_Pct'] > df_fe['Discount_Pct'].median()).astype(int)\n",
    "df_fe['Is_Profitable'] = (df_fe['Profit_USD'] > 0).astype(int)\n",
    "\n",
    "# Campaign effectiveness\n",
    "df_fe['Campaign_Effectiveness'] = np.where(\n",
    "    df_fe['Promotion_Type'] != 'No Promo',\n",
    "    df_fe['Profit_USD'] / (df_fe['Marketing_Spend_USD'] + 1),\n",
    "    0\n",
    ")\n",
    "\n",
    "# Season flags\n",
    "df_fe['Season'] = df_fe['Month'].map({\n",
    "    12: 'Winter', 1: 'Winter', 2: 'Winter',\n",
